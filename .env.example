# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Prisma loads .env from the project root.

# Supabase Postgres
# DATABASE_URL = Transaction pooler (port 6543) — ใช้ตอนรันแอป / Vercel
# DIRECT_URL   = Session / direct (port 5432) — ใช้ตอน migrate
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
MAX_DEVICES="2"

WP_LICENSE_MODE="mock"
WP_BASE_URL="https://minutessharing.com"
WP_LM_CONSUMER_KEY=""
WP_LM_CONSUMER_SECRET=""

VIDEO_PROVIDER="mock"
STREAM_TOKEN_SECRET="change-me"
STREAM_TOKEN_TTL_SECONDS="120"

# Comma-separated hostnames for https video/cover URLs (empty = allow any https)
# Example hosts below cover demo streams + common CDNs
VIDEO_ALLOWED_HOSTS="test-streams.mux.dev,stream.mux.com,bitdash-a.akamaihd.net,devstreaming-cdn.apple.com,vz-*.b-cdn.net,iframe.mediadelivery.net"

# Optional: Discord/Slack incoming webhook — posts warn/critical security events
SECURITY_WEBHOOK_URL=""

MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_PRIVATE_KEY=""

CF_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""
CF_STREAM_CUSTOMER_SUBDOMAIN=""
