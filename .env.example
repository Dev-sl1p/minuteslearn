# --- Production (Vercel) checklist ---
# AUTH_URL=https://your-domain.vercel.app
# WP_LICENSE_MODE=live
# ALLOW_MOCK_LICENSES=   (leave unset in production)
# VIDEO_PROVIDER=mux     (or leave; Drive/HLS full URLs work anyway)
# STREAM_TOKEN_SECRET=   (required in production)
# VIDEO_ALLOWED_HOSTS=stream.mux.com,image.mux.com,drive.google.com,docs.google.com,youtube.com,youtu.be,youtube-nocookie.com,*.b-cdn.net,iframe.mediadelivery.net,img1.pic.in.th,*.pic.in.th

# Supabase Postgres
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Storage (course materials) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="course-materials"
# Then: npm run storage:ensure-bucket

AUTH_SECRET="generate-with-node-crypto"
AUTH_URL="http://localhost:3000"
MAX_DEVICES="2"

# Local/dev can use mock; production forces live unless ALLOW_MOCK_LICENSES=true
WP_LICENSE_MODE="mock"
WP_BASE_URL="https://minutessharing.com"
WP_LM_CONSUMER_KEY=""
WP_LM_CONSUMER_SECRET=""

VIDEO_PROVIDER="mux"
STREAM_TOKEN_SECRET="change-me"
STREAM_TOKEN_TTL_SECONDS="120"
VIDEO_ALLOWED_HOSTS="stream.mux.com,image.mux.com,drive.google.com,docs.google.com,youtube.com,youtu.be,youtube-nocookie.com,*.b-cdn.net,iframe.mediadelivery.net,img1.pic.in.th,*.pic.in.th"

SECURITY_WEBHOOK_URL=""

MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_PRIVATE_KEY=""

CF_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""
CF_STREAM_CUSTOMER_SUBDOMAIN=""
